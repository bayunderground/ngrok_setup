# Copy to .env and fill in. Never commit .env.

# SSH target used for connection tests, e.g. ssh://user@host
SSH_HOST=ssh://bliss@pi5home

# ngrok agent authtoken (not the API key)
NGROK_AUTH_TOKEN=

# Optional reserved TCP address (paid plans only); leave empty for random endpoints
NGROK_DOMAIN=

# Telegram endpoint-change notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
