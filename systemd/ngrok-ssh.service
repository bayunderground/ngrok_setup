[Unit]
Description=ngrok TCP endpoint for local SSH
Documentation=file:///home/bliss/ngrok_setup/README.md
After=network-online.target ssh.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bliss
Group=bliss
ExecStart=/usr/local/bin/ngrok start ssh --config /home/bliss/ngrok_setup/config/ngrok-ssh.yml --config /home/bliss/.config/ngrok/ngrok.yml --log=stdout
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
